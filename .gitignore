*
!/.dockerignore
!/.gitignore
!/Dockerfile
!/Makefile
!/go.mod
!/go.sum
!/tracing.bpf.c

!/cmd/
!/cmd/tracing_service/
!/cmd/tracing_service/*.go

!/pkg/
!/pkg/tracing/
!/pkg/tracing/*.go
!/pkg/tracing_service/
!/pkg/tracing_service/*/
!/pkg/tracing_service/**/*.go
!/pkg/tracing_service/*.go

# The bpf2go output is committed on purpose: building it needs clang plus the
# kernel headers of whatever host generated it, neither of which belongs in the
# builder image. CO-RE relocates the object against the target kernel's BTF at
# load time, so one committed object serves every host. Regenerate with
# `make bpf` whenever tracing.bpf.c changes.
!/pkg/tracing_service/packet_logging_bpf_*.go
!/pkg/tracing_service/packet_logging_bpf_*.o
